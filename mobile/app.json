{
  "expo": {
    "name": "Fitly",
    "slug": "healthfit",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070910"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.healthfit.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "HealthFit needs access to your health data to sync your steps, sleep, and active calories.",
        "NSHealthUpdateUsageDescription": "HealthFit needs permission to write health data to Apple Health.",
        "NSCameraUsageDescription": "HealthFit needs access to your camera to take progress photos.",
        "NSPhotoLibraryUsageDescription": "HealthFit needs access to your photo library to select progress photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#070910"
      },
      "package": "healthyfit.launchwebsolutions",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP_SESSION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "@react-native-google-signin/google-signin",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class dev.matinzd.healthconnect.** { *; }\n-dontwarn androidx.health.connect.**"
          }
        }
      ]
    ],
    "scheme": "fitly",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "490c134a-0d64-4d06-b840-609a423f2805"
      }
    }
  }
}
